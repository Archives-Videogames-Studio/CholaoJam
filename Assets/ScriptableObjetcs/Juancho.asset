  m_Script: {fileID: 11500000, guid: 7c4baecd0b865ee48b7610a04cdc7e43, type: 3}
  m_Name: Juancho
  m_EditorClassIdentifier: Assembly-CSharp::ClientProfile
  clientName: Juancho
  portrait: {fileID: 21300000, guid: 4d9e5e6534942574683232b124864adb, type: 3}
  shortDescription: "Hincha que viene de celebrar el partido; quiere az\xFAcar fuerte,
    poco hielo y casi sin fruta."
  animatorOverride: {fileID: 22100000, guid: 2e6e095bd5b339c40b618bff507d88f2, type: 2}
  oigaLines:
  - "Menor, con este campeonato la garganta me qued\xF3 vuelta nada, no me mande
    mucho hielo."
  - "Hoy s\xED quiero az\xFAcar del alma, h\xE1game un cholado bien dulce pa\u2019
    seguir celebrando."
  - "La fruta d\xE9jela suave, yo lo que quiero es sirope del que pega duro."
  oigaKeywords:
  - garganta
  - hielo
  - "az\xFAcar"
  - dulce
  - fruta
  - suave
  - sirope
  idealFrio: 0
  idealDulzor: 2
  idealFruta: 0
  reactionPerfectLines:
  - "\xA1Uy nooo, parce! Esto est\xE1 rot\xEDsimo, golazo de cholao."
  - "As\xED s\xED se sigue celebrando, mano. Dulce, fr\xEDo\u2026 brutal."
  - "Tal cual lo ped\xED, esto levanta hasta despu\xE9s de tanda de penales."
  reactionOkLines:
  - "Est\xE1 bueno, pero le falt\xF3 un tris para la remontada, \xBFs\xED me entiende?"
  - "Me sirve para seguirla, aunque lo sent\xED un poquito bajito de az\xFAcar."
  - "Qued\xF3 bacano, pero s\xE9 que el siguiente nos queda modo final del Mundial"
  reactionBadLines:
  - "Uy, parce\u2026 ese s\xED sali\xF3 como partido perdido, \xBFqu\xE9 pas\xF3
    ah\xED?"
  - "Ni fr\xEDo ni dulce, qued\xF3 como 0\u20130 aburrido."
  - "Le ten\xEDa fe, pero este s\xED no me levant\xF3 ni la moral."
  reactionChimba: {fileID: 21300000, guid: c1f461c7f7aeb41e1a793dc5503e4abf, type: 3}
  reactionMelo: {fileID: 21300000, guid: 3c3e588c26e8841569842504a8ac39d6, type: 3}
  reactionPaila: {fileID: 21300000, guid: 12c0a22f73c834bb7a818f54aaf02e29, type: 3}
  moveSpeed: 2
