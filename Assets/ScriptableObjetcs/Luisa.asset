  m_Script: {fileID: 11500000, guid: 7c4baecd0b865ee48b7610a04cdc7e43, type: 3}
  m_Name: Luisa
  m_EditorClassIdentifier: Assembly-CSharp::ClientProfile
  clientName: Luisa
  portrait: {fileID: -5731794010346577109, guid: 3349f319a43ad5242bc0f78c81ac273b, type: 3}
  shortDescription: Estudiante creativa, cargada de trabajos; busca algo equilibrado
    pero con mucha fruta.
  oigaLines:
  - "He estado todo el d\xEDa entre clases y maquetas\u2026 necesito algo que me
    despeje, pero sin congelarme."
  - No quiero que sea muy dulce, prefiero algo balanceado que no me deje pesada.
  - "Si tiene combinaciones de fruta fresca y colores ch\xE9veres, mejor, eso siempre
    me inspira."
  idealFrio: 1
  idealDulzor: 1
  idealFruta: 2
  reactionPerfectLines:
  - "Wow\u2026 justo el equilibrio que necesitaba, me despej\xF3 la cabeza."
  - "Se siente suave, fresco y con contraste\u2026 qued\xF3 hermoso, gracias."
  - "Exactamente lo que quer\xEDa: me despierta, pero sin reventarme de dulce."
  reactionOkLines:
  - "Est\xE1 rico, aunque la pr\xF3xima lo har\xEDa un poquito m\xE1s suavecito."
  - "Me ayuda a despejarme, pero el contraste qued\xF3 un pel\xEDn fuerte."
  - "Casi perfecto, solo le bajar\xEDa un poquito a uno de los sabores."
  reactionBadLines:
  - "Uf\u2026 siento que me revuelve m\xE1s de lo que me calma, la verdad."
  - Se fue muy al extremo, no era tan intenso como lo estaba buscando.
  - "No est\xE1 mal, pero para hoy necesitaba algo menos pesado y m\xE1s equilibrado."
  reactionChimba: {fileID: 21300000, guid: cd686e38fefc6be459b8ddee08926185, type: 3}
  reactionMelo: {fileID: 21300000, guid: 47298a7cd841d4949aa96e9101ddd47d, type: 3}
  reactionPaila: {fileID: 21300000, guid: f6d8b1c9fcd34fd49b08a6bcca96878f, type: 3}
  moveSpeed: 2
